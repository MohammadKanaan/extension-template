{
  "name": "my-extension",
  "version": "0.1.0",
  "description": "A cross-browser WebExtension.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "init": "node scripts/init.mjs",
    "clean": "node scripts/clean.mjs",
    "make-icons": "node scripts/make-icons.mjs",
    "copy-static": "node scripts/copy-static.mjs",
    "compile": "tsc",
    "build": "bun run clean && bun run make-icons && bun run compile && bun run copy-static",
    "build:firefox": "bun run clean && bun run make-icons && bun run compile && node scripts/copy-static.mjs --target=firefox",
    "package:chrome": "bun run build && node scripts/package.mjs --target=chrome",
    "package:firefox": "bun run build:firefox && node scripts/package.mjs --target=firefox",
    "test": "bun run build && node --test tests/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.5",
    "@types/firefox-webext-browser": "^143.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0"
  }
}
